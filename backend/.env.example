# Application Settings
APP_NAME=VorldX Attendance API
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL 18 with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/vorldx_attendance

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone Configuration (Organization local timezone, e.g. Asia/Kolkata)
ORGANIZATION_TIMEZONE=Asia/Kolkata

# Configurable Office Shift Defaults
DEFAULT_SHIFT_START_TIME=09:00:00
DEFAULT_SHIFT_END_TIME=17:00:00
DEFAULT_SHIFT_DURATION_HOURS=8.0

# JWT Configuration (for future authentication phases)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60